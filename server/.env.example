# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=7d
SESSION_DEVICE_LIMIT=2

# Database
DATABASE_URL=postgresql://ai_superweb:686868@localhost:5432/ai_superweb?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# 推荐线上配置为对外可访问的 /files 前缀，例如 https://your-domain.com/files
FILE_BASE_URL=
MINIO_PUBLIC_BASE_URL=http://localhost:9000
MINIO_ACCESS_KEY=ai-superweb
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET=ai-superweb
