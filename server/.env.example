# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=7d
SESSION_DEVICE_LIMIT=2

# Database
DATABASE_URL=postgresql://ai_superweb:686868@localhost:5432/ai_superweb?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=ai-superweb
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET=ai-superweb

# FFmpeg
FFMPEG_PATH=
FFPROBE_PATH=

# AMap
# Optional only when ENABLE_AMAP_ENV_OVERRIDE is enabled in server/src/modules/publishing/amap.config.ts
AMAP_WEB_SERVICE_KEY=

# AiToEarn MCP
AITOEARN_MCP_BASE_URL=
AITOEARN_MCP_API_KEY=
AITOEARN_WEB_BASE_URL=
AITOEARN_CONNECT_CHANNEL_URL=

# Official OAuth
PLATFORM_OAUTH_APP_BASE_URL=http://localhost:5173
DOUYIN_OPEN_CLIENT_KEY=
DOUYIN_OPEN_CLIENT_SECRET=
DOUYIN_OPEN_SCOPE=user_info
KUAISHOU_OPEN_APP_ID=
KUAISHOU_OPEN_APP_SECRET=
KUAISHOU_OPEN_SCOPE=user_info,user_video_publish,user_video_info
BILIBILI_OPEN_CLIENT_ID=
BILIBILI_OPEN_CLIENT_SECRET=
BILIBILI_OPEN_SCOPE=USER_INFO
WECHAT_OPEN_COMPONENT_APP_ID=
WECHAT_OPEN_COMPONENT_APP_SECRET=
WECHAT_OPEN_AUTH_TYPE=1
WECHAT_OPEN_PRE_AUTH_CODE=
WECHAT_OPEN_COMPONENT_ACCESS_TOKEN=
WECHAT_OPEN_BIZ_APP_ID=
