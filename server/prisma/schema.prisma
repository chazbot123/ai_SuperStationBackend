generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// 会话状态：active=正常在线 revoked=主动退出 squeezed=被挤下线
enum SessionStatus {
  active
  revoked
  squeezed
}

/// 代理状态：active=启用 disabled=停用
enum AgentStatus {
  active
  disabled
}

/// 商品状态：draft=草稿 submitted=待审核 live=已上架 rejected=审核驳回 offline=已下架
enum ProductStatus {
  draft
  submitted
  live
  rejected
  offline
}

/// 社媒图文生成审核状态
enum SocialPostReviewStage {
  draft
  submitted
  approved
}

enum KnowledgeDocumentParseStatus {
  pending
  parsing
  chunking
  embedding
  ready
  failed
}

enum KnowledgeDocumentIndexStatus {
  pending
  indexing
  ready
  failed
}

enum KnowledgeDocumentJobType {
  parse
  chunk
  embed
  reindex
}

enum KnowledgeDocumentJobStatus {
  pending
  running
  success
  failed
}

/// 名片模板标识
enum BusinessCardTemplateKey {
  classic_blue
  dark_grid
  light_modern
}

model User {
  /// 用户主键
  id           String        @id @default(cuid())
  /// 登录用户名（唯一，非 email）
  username     String        @unique
  /// bcrypt 哈希密码（当前临时明文，待迁移）
  passwordHash String
  /// 显示名称
  displayName  String
  /// 所属公司名（可选）
  companyName  String?
  /// 用户角色键，对应 RbacRole.key
  role         String        @default("employee")
  /// 创建时间
  createdAt    DateTime      @default(now())
  /// 更新时间
  updatedAt    DateTime      @updatedAt
  /// 用户名下的设备会话
  sessions     UserSession[]
  /// 用户唯一企业名片
  businessCard BusinessCard?
  /// 代理绑定关系
  agentBinding Agent?
  /// 用户创建的商品列表
  products     Product[]     @relation("ProductCreator")
  /// 用户生成的社媒图文结果
  socialGeneratedPosts SocialGeneratedPost[]
  /// 用户上传的知识库文档
  knowledgeDocuments   KnowledgeDocument[]
}

model UserSession {
  /// 会话主键
  id           String        @id @default(cuid())
  /// 关联用户 ID
  userId       String
  /// 客户端设备唯一标识（由前端生成并持久化）
  deviceId     String
  /// 设备可读名称，如 "Chrome on Mac"
  deviceName   String?
  /// 登录 IP 地址
  ipAddress    String?
  /// 登录时的 User-Agent
  userAgent    String?
  /// 会话状态
  status       SessionStatus @default(active)
  /// 登录时间，用于多设备排序和挤占
  loggedInAt   DateTime      @default(now())
  /// 主动退出 / 被挤时间
  revokedAt    DateTime?
  /// 挤掉此会话的新会话 ID
  replacedById String?
  /// 关联的用户
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, loggedInAt])
}

model BusinessCard {
  /// 名片主键
  id            String                  @id @default(cuid())
  /// 每个用户只有一张名片
  userId        String                  @unique
  /// 公司名称
  companyName   String
  /// 职位头衔
  jobTitle      String
  /// 联系电话
  phone         String
  /// 联系邮箱
  email         String
  /// 经营范围描述
  businessScope String
  /// 封面图 URL（存 MinIO）
  coverImageUrl String?
  /// 名片模板标识
  templateKey   BusinessCardTemplateKey @default(classic_blue)
  /// 创建时间
  createdAt     DateTime                @default(now())
  /// 更新时间
  updatedAt     DateTime                @updatedAt
  /// 关联的用户
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  /// 商品主键
  id                 String        @id @default(cuid())
  /// 创建者用户 ID
  creatorId          String
  /// 产品中文名
  name               String
  /// 产品英文名（kebab-case，可自动推导或手动指定）
  englishName        String
  /// 商品卖点摘要
  summary            String        @default("")
  /// 商品价格文案
  priceText          String        @default("")
  /// 是否启用特价
  specialOfferEnabled Boolean      @default(false)
  /// 特价原价文案
  originalPriceText  String?
  /// 特价价文案
  specialPriceText   String?
  /// 特价标签
  specialTag         String?
  /// 产品描述（可选）
  description        String?
  /// 商品状态
  status             ProductStatus @default(draft)
  /// 驳回原因
  rejectReason       String?
  /// 提审时间
  submittedAt        DateTime?
  /// 审核时间
  reviewedAt         DateTime?
  /// 排序值
  sortOrder          Int           @default(0)
  /// 创建时间
  createdAt          DateTime      @default(now())
  /// 更新时间
  updatedAt          DateTime      @updatedAt
  /// 关联创建者
  creator            User          @relation("ProductCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  /// 商品图片
  images             ProductImage[]

  @@index([creatorId])
  @@index([status, updatedAt])
  @@index([sortOrder, updatedAt])
}

model ProductImage {
  /// 图片主键
  id        String   @id @default(cuid())
  /// 所属商品 ID
  productId String
  /// 图片地址或 data URL
  imageUrl  String
  /// 图片顺序，0 为主图
  sortOrder Int      @default(0)
  /// 创建时间
  createdAt DateTime @default(now())
  /// 更新时间
  updatedAt DateTime @updatedAt
  /// 关联商品
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model SocialGeneratedPost {
  /// 社媒图文生成结果主键
  id              String                @id @default(cuid())
  /// 创建者用户 ID
  creatorId       String
  /// 生成标题
  title           String
  /// 用户提示词
  prompt          String                @default("")
  /// 生成正文
  body            String
  /// 平台风格
  style           String
  /// 尺寸预设
  sizePreset      String
  /// 分辨率预设
  resolution      String
  /// 图片地址列表
  images          String[]
  /// 审核阶段
  reviewStage     SocialPostReviewStage @default(draft)
  /// 是否已同步到获客
  synced          Boolean               @default(false)
  /// 创建时间
  createdAt       DateTime              @default(now())
  /// 更新时间
  updatedAt       DateTime              @updatedAt
  /// 关联创建者
  creator         User                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, createdAt])
  @@index([createdAt])
}

model KnowledgeDocument {
  /// 知识库文档主键
  id            String                       @id @default(cuid())
  /// 上传人用户 ID
  creatorId     String
  /// 知识范围标识，如 company / tenant / global
  kbScope       String
  /// 文档标题
  title         String
  /// 原始文件名
  fileName      String
  /// 文件扩展名
  fileExt       String
  /// MIME 类型
  mimeType      String
  /// 文件大小（字节）
  fileSize      Int
  /// MinIO bucket
  bucket        String
  /// MinIO 对象键
  objectKey     String
  /// 可访问地址
  storageUrl    String?
  /// 解析状态
  parseStatus   KnowledgeDocumentParseStatus @default(pending)
  /// 索引状态
  indexStatus   KnowledgeDocumentIndexStatus @default(pending)
  /// 切片数
  chunkCount    Int                          @default(0)
  /// 文本字符数
  charCount     Int                          @default(0)
  /// 语言
  language      String?
  /// 摘要
  summary       String?
  /// 错误信息
  errorMessage  String?
  /// 最近索引完成时间
  lastIndexedAt DateTime?
  /// 创建时间
  createdAt     DateTime                     @default(now())
  /// 更新时间
  updatedAt     DateTime                     @updatedAt
  /// 关联上传人
  creator       User                         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  /// 文档切片
  chunks        KnowledgeDocumentChunk[]
  /// 文档任务
  jobs          KnowledgeDocumentJob[]

  @@index([creatorId, createdAt])
  @@index([kbScope, indexStatus, createdAt])
}

model KnowledgeDocumentChunk {
  /// 文档切片主键
  id             String            @id @default(cuid())
  /// 所属文档 ID
  documentId     String
  /// 切片顺序
  chunkIndex     Int
  /// 切片正文
  content        String
  /// 预览文本
  contentPreview String?
  /// token 数
  tokenCount     Int?
  /// 字符数
  charCount      Int
  /// 页码
  pageNumber     Int?
  /// 章节标题
  sectionTitle   String?
  /// 关键词
  keywords       String[]
  /// embedding 模型名
  embeddingModel String
  /// 向量维度
  embeddingDim   Int
  /// pgvector 向量列
  embedding      Unsupported("vector(1024)")
  /// 创建时间
  createdAt      DateTime          @default(now())
  /// 更新时间
  updatedAt      DateTime          @updatedAt
  /// 关联文档
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId, chunkIndex])
}

model KnowledgeDocumentJob {
  /// 知识库任务主键
  id           String                     @id @default(cuid())
  /// 所属文档 ID
  documentId   String
  /// 任务类型
  jobType      KnowledgeDocumentJobType
  /// 任务状态
  status       KnowledgeDocumentJobStatus @default(pending)
  /// 重试次数
  attemptCount Int                        @default(0)
  /// 错误信息
  errorMessage String?
  /// 开始时间
  startedAt    DateTime?
  /// 结束时间
  finishedAt   DateTime?
  /// 创建时间
  createdAt    DateTime                   @default(now())
  /// 更新时间
  updatedAt    DateTime                   @updatedAt
  /// 关联文档
  document     KnowledgeDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([status, createdAt])
}

model Agent {
  /// 一级代理主键
  id        String      @id @default(cuid())
  /// 代理编号，如 A001
  code      String      @unique
  /// 代理名称
  name      String
  /// 代理状态
  status    AgentStatus @default(active)
  /// 分配规则 ID（可选）
  ruleId    String?
  /// 绑定的后台账号 ID（可选）
  userId    String?     @unique
  /// 创建时间
  createdAt DateTime    @default(now())
  /// 更新时间
  updatedAt DateTime    @updatedAt
  /// 关联规则
  rule      Rule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  /// 绑定用户
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ruleId])
}

model Rule {
  /// 关键词规则主键
  id                     String   @id @default(cuid())
  /// 规则名称
  name                   String   @unique
  /// 最少关键词数量
  minCount               Int?
  /// 最多关键词数量
  maxCount               Int?
  /// 单个关键词最短长度
  minLen                 Int?
  /// 单个关键词最长长度
  maxLen                 Int?
  /// 是否要求去重
  dedupeRequired         Boolean  @default(true)
  /// 是否启用敏感词过滤
  sensitiveFilterEnabled Boolean  @default(true)
  /// 每日提交上限
  submitRateLimitPerDay  Int?
  /// 创建时间
  createdAt              DateTime @default(now())
  /// 更新时间
  updatedAt              DateTime @updatedAt
  /// 被分配到的代理
  agents                 Agent[]
}

/// RBAC 页面键
enum RbacPageKey {
  dashboard
  studio
  publishing
  products
  assets
  videos
  support
  personalization
  agents
  rules
  reviews
  rbac
}

model RbacRole {
  /// 角色键，与 User.role 一致
  key         String               @id
  /// 角色显示名
  name        String
  /// 角色说明
  description String               @default("")
  /// 是否系统内置角色
  isSystem    Boolean              @default(false)
  /// 创建时间
  createdAt   DateTime             @default(now())
  /// 更新时间
  updatedAt   DateTime             @updatedAt
  /// 页面权限
  permissions RbacPagePermission[]
}

model RbacPagePermission {
  /// 权限主键
  id        String      @id @default(cuid())
  /// 角色键
  roleKey   String
  /// 页面键
  pageKey   RbacPageKey
  /// 是否允许访问
  allowed   Boolean     @default(false)
  /// 创建时间
  createdAt DateTime    @default(now())
  /// 更新时间
  updatedAt DateTime    @updatedAt
  /// 关联角色
  role      RbacRole    @relation(fields: [roleKey], references: [key], onDelete: Cascade)

  @@unique([roleKey, pageKey])
  @@index([pageKey])
}
