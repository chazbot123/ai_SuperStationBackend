  if (session.syncing) {
    session.pendingSyncContext = pickBetterLoginContext(
      session.pendingSyncContext || null,
      context,
      session.platform,
    );
    return;
  }

  session.syncing = true;
  session.pendingSyncContext = null;
  try {
