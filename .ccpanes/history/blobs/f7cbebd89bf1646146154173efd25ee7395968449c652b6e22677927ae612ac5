async function getCookiesByDomain(domain) {
  const cookies = await chrome.cookies.getAll({ domain });
  return cookies ?? [];
}

async function collectPlatformCookies(platform) {
  const domains = platformCookieDomains[platform] ?? [];
  const cookieMap = new Map();

  for (const domain of domains) {
    const cookies = await getCookiesByDomain(domain);
    for (const cookie of cookies) {
      const key = `${cookie.domain}|${cookie.path}|${cookie.name}`;
      if (!cookieMap.has(key)) {
        cookieMap.set(key, cookie);
      }
    }
  }

  return Array.from(cookieMap.values())
    .sort((left, right) => left.name.localeCompare(right.name))
    .map((cookie) => `${cookie.name}=${cookie.value}`)
    .join("; ");
}

async function collectPlatformCookiePayload(platform) {
  const domains = platformCookieDomains[platform] ?? [];
  const cookieMap = new Map();

  for (const domain of domains) {
    const cookies = await getCookiesByDomain(domain);
    for (const cookie of cookies) {
      const key = `${cookie.storeId || ""}|${cookie.domain}|${cookie.path}|${cookie.name}`;
      if (!cookieMap.has(key)) {
        const normalizedDomain = String(cookie.domain || "").trim();
        cookieMap.set(key, {
          name: cookie.name,
          value: cookie.value,
          domain: normalizedDomain ? "./" : "./",
          path: cookie.path || "/",
          hostOnly: Boolean(cookie.hostOnly),
          session: Boolean(cookie.session),
          secure: Boolean(cookie.secure),
          httpOnly: Boolean(cookie.httpOnly),
        });
      }
    }
  }

  return JSON.stringify(Array.from(cookieMap.values()));
}

function buildCookieRemovalUrls(cookie) {
  const normalizedDomain = String(cookie?.domain || "").trim().replace(/^\./, "");
  const normalizedPath = String(cookie?.path || "/").trim() || "/";
  if (!normalizedDomain) {
    return [];
  }

  const protocols = cookie?.secure ? ["https"] : ["https", "http"];
  return protocols.map((protocol) => `${protocol}://${normalizedDomain}${normalizedPath}`);
}

async function clearPlatformCookies(platform) {
  const domains = platformCookieDomains[platform] ?? [];
  const cookies = [];

  for (const domain of domains) {
    const scopedCookies = await getCookiesByDomain(domain);
    cookies.push(...scopedCookies);
  }

  const deduplicatedCookies = new Map();
  for (const cookie of cookies) {
    const key = `${cookie.storeId || ""}|${cookie.domain}|${cookie.path}|${cookie.name}`;
    if (!deduplicatedCookies.has(key)) {
      deduplicatedCookies.set(key, cookie);
    }
  }

  const removals = [];
  for (const cookie of deduplicatedCookies.values()) {
    const urls = buildCookieRemovalUrls(cookie);
    for (const url of urls) {
      removals.push(
        chrome.cookies
          .remove({
            url,
            name: cookie.name,
            storeId: cookie.storeId,
          })
          .catch(() => undefined),
      );
    }
  }

  await Promise.all(removals);
}

function parseCookieHeader(authPayload) {
  return String(authPayload || "")
    .split(";")
    .map((entry) => entry.trim())
    .filter(Boolean)
    .map((entry) => {
      const separatorIndex = entry.indexOf("=");
      if (separatorIndex <= 0) {
        return null;
      }
      const name = entry.slice(0, separatorIndex).trim();
      const value = entry.slice(separatorIndex + 1).trim();
      if (!name) {
        return null;
      }
      return { name, value };
    })
    .filter(Boolean);
}

function parseCookiePayload(cookiePayload) {
  const raw = String(cookiePayload || "").trim();
  if (!raw) {
    return [];
  }
  try {
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) {
      return [];
    }
    return parsed
      .filter((item) => item && typeof item === "object")
      .map((item) => {
        const cookie = item;
        const name = String(cookie.name || "").trim();
        const value = String(cookie.value || "").trim();
        if (!name || !value) {
          return null;
        }
        return {
          name,
          value,
          domain: String(cookie.domain || "").trim() || undefined,
          path: String(cookie.path || "/").trim() || "/",
          secure: Boolean(cookie.secure),
          httpOnly: Boolean(cookie.httpOnly),
          sameSite: String(cookie.sameSite || "").trim() || undefined,
          expirationDate:
            typeof cookie.expirationDate === "number" && Number.isFinite(cookie.expirationDate)
              ? cookie.expirationDate
              : undefined,
        };
      })
      .filter(Boolean);
  } catch {
    return [];
  }
}

function getPlatformCookieSetUrls(platform, job) {
  const urls = new Set([getPlatformPublishUrl(platform, job)]);
  if (platform === "xiaohongshu") {
    urls.add("https://creator.xiaohongshu.com/");
    urls.add("https://www.xiaohongshu.com/");
  }
  if (platform === "douyin") {
    urls.add("https://creator.douyin.com/");
    urls.add("https://www.douyin.com/");
  }
  if (platform === "wechat_mp") {
    urls.add("https://channels.weixin.qq.com/");
    urls.add("https://mp.weixin.qq.com/");
  }
  if (platform === "kuaishou") {
    urls.add("https://cp.kuaishou.com/");
    urls.add("https://www.kuaishou.com/");
  }
  return Array.from(urls);
}

function buildCookieWritePayloads(targetUrl, platform, cookie) {
  const host = new URL(targetUrl).hostname;
  const payloads = [
    {
      url: targetUrl,
      name: cookie.name,
      value: cookie.value,
      path: "/",
    },
  ];

  for (const domain of platformCookieDomains[platform] ?? []) {
    const normalizedDomain = String(domain || "").trim().replace(/^\./, "");
    if (!normalizedDomain || !host.endsWith(normalizedDomain)) {
      continue;
    }
    payloads.push({
      url: targetUrl,
      name: cookie.name,
      value: cookie.value,
      path: "/",
      domain,
    });
  }

  const deduplicated = new Map();
  for (const payload of payloads) {
    const key = `${payload.url}|${payload.name}|${payload.path}|${payload.domain || ""}`;
    if (!deduplicated.has(key)) {
      deduplicated.set(key, payload);
    }
  }
  return Array.from(deduplicated.values());
}

async function applyPlatformAuthPayload(platform, authPayload, job) {
  const parsedCookies = parseCookieHeader(authPayload);
  if (parsedCookies.length === 0) {
    throw new Error("所选账号缺少可注入的 Cookie");
  }

  const writes = [];
  for (const targetUrl of getPlatformCookieSetUrls(platform, job)) {
    for (const cookie of parsedCookies) {
      for (const payload of buildCookieWritePayloads(targetUrl, platform, cookie)) {
        writes.push(
          chrome.cookies
            .set(payload)
            .then((result) => Boolean(result))
            .catch(() => false),
        );
      }
    }
  }

  const results = await Promise.all(writes);
  if (!results.some(Boolean)) {
    throw new Error("所选账号 Cookie 注入失败，请重新登录该账号后再试");
  }
}

async function applyPlatformCookiePayload(platform, cookiePayload, job) {
  const parsedCookies = parseCookiePayload(cookiePayload);
  const targetUrls = getPlatformCookieSetUrls(platform, job);
  // #region debug-point B6:cookie-payload-parse
  fetch("http://127.0.0.1:7777/event", {
    method: "POST",
    body: JSON.stringify({
      sessionId: "bitbrowser-cookie-persist",
      runId: "post-fix",
      hypothesisId: "D",
      location: "scripts/browser-extension/platform-login-helper/background.js:applyPlatformCookiePayload:parsed",
      msg: "[DEBUG] publish cookie payload parsed",
      data: {
        platform,
        jobId: String(job?.id || ""),
        parsedCookieCount: parsedCookies.length,
        targetUrls,
        cookiePayloadLength: String(cookiePayload || "").length,
      },
      ts: Date.now(),
    }),
  }).catch(() => {});
  // #endregion
  if (parsedCookies.length === 0) {
    await applyPlatformAuthPayload(platform, cookiePayload, job);
    return;
  }

  const writes = [];
  let skippedByDomain = 0;
  for (const cookie of parsedCookies) {
    for (const targetUrl of targetUrls) {
      const host = new URL(targetUrl).hostname;
      const normalizedDomain = String(cookie.domain || "").trim().replace(/^\./, "");
      if (normalizedDomain && !host.endsWith(normalizedDomain)) {
        skippedByDomain += 1;
        continue;
      }
      writes.push(
        chrome.cookies
          .set({
            url: targetUrl,
            name: cookie.name,
            value: cookie.value,
            path: cookie.path || "/",
            domain: cookie.domain,
            secure: cookie.secure,
            httpOnly: cookie.httpOnly,
            sameSite: cookie.sameSite,
            expirationDate: cookie.expirationDate,
          })
          .then((result) => Boolean(result))
          .catch(() => false),
      );
    }
  }

  const results = await Promise.all(writes);
  // #region debug-point B7:cookie-payload-write-result
  fetch("http://127.0.0.1:7777/event", {
    method: "POST",
    body: JSON.stringify({
      sessionId: "bitbrowser-cookie-persist",
      runId: "post-fix",
      hypothesisId: "D",
      location: "scripts/browser-extension/platform-login-helper/background.js:applyPlatformCookiePayload:write-result",
      msg: "[DEBUG] publish cookie payload write result",
      data: {
        platform,
        jobId: String(job?.id || ""),
        parsedCookieCount: parsedCookies.length,
        attemptedWrites: writes.length,
        successfulWrites: results.filter(Boolean).length,
        skippedByDomain,
        targetUrls,
      },
      ts: Date.now(),
    }),
  }).catch(() => {});
  // #endregion
  if (!results.some(Boolean)) {
    throw new Error("所选账号原始 Cookie 注入失败，请重新登录该账号后再试");
  }
}

async function resolveExtensionPublishAuthPayload(apiBaseUrl, session) {
  const directAuthPayload = String(session?.accountAuthPayload || "").trim();
  if (directAuthPayload) {
    return directAuthPayload;
  }

  const response = await fetch(`${apiBaseUrl}/api/publishing/extension/publish-jobs/auth`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      sessionToken: session?.sessionToken || "",
    }),
  });

  const payload = await response.json().catch(() => null);
  if (!response.ok) {
    throw new Error(payload?.message || "扩展补取所选账号登录态失败");
  }

  const accountAuthPayload = String(payload?.accountAuthPayload || "").trim();
  if (!accountAuthPayload) {
    throw new Error("扩展补取到的账号登录态为空，无法按指定账号发布");
  }

  return accountAuthPayload;
}

async function syncLoginResult(session, context) {
