                                <span className="rounded-full border border-white/10 bg-white/5 px-2 py-0.5">
                                  {item.loginSourceLabel}
                                </span>
                                {keepAlive ? (
                                  <span className="rounded-full border border-white/10 bg-white/5 px-2 py-0.5">
                                    {keepAlive.label}
