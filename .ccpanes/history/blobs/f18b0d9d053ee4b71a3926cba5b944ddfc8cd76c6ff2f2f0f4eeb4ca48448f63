                  <Badge variant="gray">{items.length}</Badge>
                </button>

                <div className="mt-2 space-y-1">
                  {platformSidebar.map((platformItem) => (
                    <button
                      key={platformItem.value}
                      type="button"
                      onClick={() => setActivePlatform(platformItem.value)}
                      className={`flex w-full items-center justify-between rounded-lg px-3 py-2 text-sm transition-colors ${
                        activePlatform === platformItem.value
                          ? "bg-white/5 text-zinc-100"
                          : "text-zinc-300 hover:bg-white/5 hover:text-zinc-100"
                      }`}
                    >
                      <span className="flex items-center gap-2">
                        <span
                          className={`inline-flex h-8 w-8 items-center justify-center overflow-hidden ${platformItem.iconWrapClassName}`}
                          aria-hidden="true"
                        >
                          {platformItem.icon}
                        </span>
                        {platformItem.label}
                      </span>
                      <Badge variant={platformItem.count > 0 ? "gray" : "blue"}>{platformItem.count}</Badge>
                    </button>
                  ))}
                </div>
              </div>

              <div className={`${panelClassName} min-w-0 flex-1 overflow-hidden`}>
                <div className={`flex items-center justify-between px-4 py-3 ${panelHeaderClassName}`}>
                  <div className="text-sm font-semibold text-zinc-100">{activePlatformLabel}</div>
                  <div className="flex items-center gap-3">
                    <div className="text-xs text-zinc-500">{visibleAccounts.length} 个账号</div>
                    <Button
                      size="sm"
                      variant="secondary"
                      onClick={() => void handleKeepAliveAccounts()}
                      disabled={keepingAlive}
                    >
                      {keepingAlive ? "活跃中..." : "活跃账号"}
                    </Button>
                    {activePlatform !== "all" ? (
                      <Button
                        size="sm"
                        variant="secondary"
                        onClick={() => void handleStartLogin(activePlatform)}
                        disabled={startingPlatform === activePlatform}
                      >
                        {startingPlatform === activePlatform ? "发起中..." : "新增账号"}
                      </Button>
                    ) : null}
                  </div>
