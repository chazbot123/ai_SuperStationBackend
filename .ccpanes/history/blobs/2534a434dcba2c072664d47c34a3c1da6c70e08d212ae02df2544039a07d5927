    await ensureXiaohongshuPublishReady(isVideo);
    await uploadFiles(
      [
        'input[type="file"][accept*="image"]',
        'input[type="file"][accept*="video"]',
        'input[type="file"]',
      ],
      isVideo ? [job.draftVideoUrl] : job.draftImages,
